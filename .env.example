# Server port (default: 8001 locally, 8080 in Cloud Run via Dockerfile)
PORT=8001

# Public URL of this agent (used in the A2A agent card)
AGENT_URL=http://localhost:8001

# LLM model identifier
# Local dev:  ollama/llama3.1:8b (default — requires Ollama running locally)
# Cloud Run:  openai/gpt-4o-mini  (set via Terraform, see infra/variables.tf)
LLM_MODEL=ollama/llama3.1:8b

# API key for the LLM provider (not needed for local Ollama)
# OPENAI_API_KEY=sk-...
